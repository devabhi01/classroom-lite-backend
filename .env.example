# TDP Classroom Lite - Environment Variables Example
# Copy this file to .env and fill in your values

PORT=3000
MONGODB_URI=mongodb+srv://antigravty:antigravity01@classroom-lite.kzdpqw5.mongodb.net/classroom-lite?appName=classroom-lite
JWT_SECRET=replace-with-a-secure-secret
JWT_EXPIRES_IN=1d
# Allowed frontend origin(s) that can access this backend via REST API, static files, and WebSockets.
# Supports:
#   - Single origin: FRONTEND_URL=https://my-classroom.vercel.app
#   - Multiple origins: FRONTEND_URL=https://my-classroom.vercel.app,http://localhost:5173
#   - Wildcard domains: FRONTEND_URL=https://*.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Email Confirmation (SMTP Configuration)
# If omitted or left empty, verification links and OTP codes will be logged to the console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="TDP Classroom Lite" <noreply@tdpclassroom.com>

# SMS OTP Configuration (Twilio or Fast2SMS)
# If omitted or left empty, SMS OTP codes will be logged to the server console
# Option 1: Twilio (Global SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option 2: Fast2SMS (India)
FAST2SMS_API_KEY=

